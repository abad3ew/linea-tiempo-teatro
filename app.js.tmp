let data=[];const $=s=>document.querySelector(s);const esc=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));async function init(){try{data=await fetch('data.json').then(r=>r.json())}catch(e){data=[]}const f=$('#periodFilter');[...new Set(data.map(x=>x.periodo))].forEach(p=>f.insertAdjacentHTML('beforeend',`<option value="${esc(p)}">${esc(p)}</option>`));render()}function getItems(){const q=$('#search').value.trim().toLowerCase(),f=$('#periodFilter').value;return data.filter(x=>(f==='all'||x.periodo===f)&&(!q||JSON.stringify(x).toLowerCase().includes(q)))}function render(){const items=getItems();$('#empty').hidden=items.length!==0;$('#cards').innerHTML=items.map(x=>{const n=data.indexOf(x);return `<article class="timeline-item"><div class="timeline-index">${String(n+1).padStart(2,'0')}</div><div class="card" tabindex="0" role="button" onclick="openItem(${n})" onkeydown="if(event.key==='Enter'||event.key===' ')openItem(${n})"><div class="card-top"><span class="period">${esc(x.periodo)}</span><span class="date">${esc(x.fecha)}</span></div><h3>${esc(x.titulo)}</h3><p>${esc(x.resumen)}</p><div class="chips">${(x.apunte||[]).slice(0,4).map(t=>`<span class="chip note-chip">${esc(t)}</span>`).join('')}</div><span class="arrow">↗</span></div></article>`}).join('');drawMarkers(items)}function drawMarkers(items){$('#markers').innerHTML=items.map((x,i)=>`<button class="marker" style="top:${i*229+105}px" title="${esc(x.titulo)}" onclick="openItem(${data.indexOf(x)})"></button>`).join('');updateTrack()}function updateTrack(){const s=document.querySelector('.timeline-shell'),p=$('#trackProgress');if(!s)return;const r=s.getBoundingClientRect(),h=Math.max(s.offsetHeight,1),seen=Math.min(h,Math.max(0,innerHeight-r.top));p.style.height=`${Math.min(100,seen/h*100)}%`}function openItem(i){const x=data[i];$('#modalContent').innerHTML=`<div class="modal-date">${esc(x.periodo)} · ${esc(x.fecha)}</div><h2>${esc(x.titulo)}</h2><p class="lead">${esc(x.resumen)}</p><div class="detail-grid"><div><h4>CONTENIDO DE LA PPT</h4><ul>${(x.puntos||[]).map(v=>`<li>${esc(v)}</li>`).join('')}</ul></div><div><h4>PERSONAJES Y OBRAS</h4><p>${[...(x.personajes||[]),...(x.obras||[])].map(v=>`<span class="chip">${esc(v)}</span> `).join('')||'No especificados.'}</p></div></div><div class="note-box"><strong>APUNTE DE CLASE ASOCIADO</strong><p>${(x.apunte||[]).map(esc).join(' · ')}</p></div><button class="api-btn" onclick="apiContext(${i})">Consultar contexto dinámico ↗</button><div id="apiResult" class="api-result" hidden></div><p style="color:#62656d;font-size:.68rem;margin-top:18px">${esc(x.fuente)}</p>`;$('#modal').classList.add('open');document.body.style.overflow='hidden'}async function apiContext(i){const o=$('#apiResult');o.hidden=false;o.textContent='Consultando…';try{const x=data[i],r=await fetch(`https://es.wikipedia.org/api/rest_v1/page/summary/${encodeURIComponent(x.apiQuery.replace(/\s+/g,'_'))}`);if(!r.ok)throw Error();const d=await r.json();o.innerHTML=`<strong>${esc(d.title)}</strong><p>${esc(d.extract||'Sin resumen.')}</p>${d.content_urls?.desktop?.page?`<a target="_blank" rel="noopener" href="${d.content_urls.desktop.page}">Abrir referencia ↗</a>`:''}`}catch(e){o.textContent='La API no respondió; el contenido local continúa disponible.'}}function closeModal(){$('#modal').classList.remove('open');document.body.style.overflow=''}$('#search').addEventListener('input',render);$('#periodFilter').addEventListener('change',render);$('#clearBtn').addEventListener('click',()=>{$('#search').value='';$('#periodFilter').value='all';render()});$('#close').addEventListener('click',closeModal);$('#modal').addEventListener('click',e=>{if(e.target.id==='modal')closeModal()});document.addEventListener('keydown',e=>{if(e.key==='Escape')closeModal()});addEventListener('scroll',()=>{updateTrack();document.querySelectorAll('.marker').forEach(m=>{const r=m.getBoundingClientRect();m.classList.toggle('active',r.top>80&&r.top<innerHeight*.65)})},{passive:true});$('#startBtn').addEventListener('click',()=>document.querySelector('.explorer').scrollIntoView({behavior:'smooth'}));$('#themeBtn').addEventListener('click',()=>document.body.classList.toggle('light'));init();